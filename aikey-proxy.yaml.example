# aikey-proxy schema sample (example)
#
# ── Purpose ───────────────────────────────────────────────────────────────
# This file is the **canonical schema reference** for the proxy yaml. It is
# consumed by:
#
#   - aikey-proxy/scripts/dev-setup.sh        (templates a fresh ~/.aikey/config/)
#   - aikey-proxy/scripts/deploy-integration.sh
#   - workflow/CD/publish/release.sh           (cps into release tarball
#                                               `bundle/config/default/aikey-proxy.yaml`
#                                               as the first-install default)
#
# It is **NOT** loaded directly by `aikey proxy start` runtime — the cwd-first
# resolution was removed 2026-05-21. See:
#   - workflow/CI/bugfix/20260521-proxy-config-cwd-first-loads-stale-dev-fixture.md
#   - roadmap20260320/技术实现/开源版本方案/config-split-system-user.md §v9
#
# Field set MUST be a SUBSET of the system layer logical shape rendered by
# `aikey-config-tool render --profile personal`. PR-gate
# `make test-config-split-dev-fixture` enforces this. Token-bearing fields
# use `<dev-placeholder>` so it's obvious they need real values from the
# installer's render step (or operator-provided secrets).
#
# Field reference: workflow/CD/templates/common/aikey-proxy.yaml.tmpl
# ──────────────────────────────────────────────────────────────────────────

listen:
  host: "127.0.0.1"
  port: 27200

vault:
  path: "~/.aikey/data/vault.db"

# Local AiKey console base (aikey-local-server web, 8090 on a default personal
# install). Used to assemble the member-login URL shown inside claude/codex
# when a shared pool account requires sign-in
# (OAUTH_GROUP_MEMBER_LOGIN_REQUIRED → <console>/user/team-oauth).
# Empty ⇒ the error message falls back to URL-less wording.
console_url: "http://127.0.0.1:8090"
# Chat Completions bridge — OFF by default.
#
# A ChatGPT OAuth (codex) credential's upstream, chatgpt.com/backend-api/codex,
# serves ONLY the OpenAI Responses API (/responses). Clients speaking the
# ordinary Chat Completions dialect (the OpenAI SDKs, opencode, ai-sdk,
# LangChain, Cursor, ...) are refused with OAUTH_RESPONSES_ONLY.
#
# enabled: true makes AiKey translate instead of refusing, in either direction,
# turning a team ChatGPT subscription into a general OpenAI-compatible endpoint.
# Off changes nothing about today's behaviour, and /v1/responses traffic is
# unaffected in either state.
#
# 🔴 DO NOT turn it on by editing THIS file. This is the SYSTEM layer — it is
# re-rendered on every install, so a change here is silently reverted on the
# next upgrade. Set it in the USER layer, which is never re-rendered and wins
# on merge (same place upstream_proxy lives):
#
#   # ~/.aikey/config/aikey-user.yaml
#   proxy:
#     chat_completions_bridge:
#       enabled: true
#
# upstreams — where an OAuth credential may send its token, and what each
# destination speaks. Empty (the default) means ONE destination is reachable:
# the compiled-in chatgpt.com/backend-api/codex.
#
# 🔴 This list is a security boundary. An OAuth access token is not a key the
# customer can cheaply rotate — it IS the ChatGPT subscription, and any host
# that receives one holds the whole account. So there is no wildcard form,
# entries are matched by exact hostname, and a non-https destination is refused
# unless it is loopback. `dialect` is REQUIRED (responses | chat_completions):
# guessing it would send a well-formed request in the wrong shape, so a missing
# value fails startup instead.
#
#   upstreams:
#     - host: "relay.corp.example"
#       dialect: "chat_completions"
chat_completions_bridge:
  enabled: false
  upstreams: []



# Virtual keys are delivered via vault (managed_virtual_keys_cache or
# personal_route_token columns). Add keys with `aikey add <alias>
# --provider <name>`, then `aikey list` / `aikey route` for the bearer
# token. Static virtual_keys[] declarations were removed; see
# workflow/CD/templates/removed-registry.yaml for the removal record.

# Provider protocol configuration.
providers:
  openai:
    protocol: "openai"
    timeout: 120s
  anthropic:
    protocol: "anthropic"
    timeout: 120s
  kimi:
    protocol: "kimi"
    timeout: 120s

# Events (usage tracking) configuration.
events:
  db_path: "~/.aikey/data/events.db"
  batch_size: 100
  flush_interval: 5s

  # Usage reporting to collector-service.
  #
  # `collector_url` is the legacy single-destination field — events for
  # any RouteSource not matched by `collector_routes` below fall through
  # to this URL. Personal / Trial use 127.0.0.1:8090 (local-server);
  # Production deployments may point at a remote collector container.
  #
  # `collector_token` (legacy) and `service_token` are the bearer secrets
  # the collector-service validates. They are placeholders here — the
  # installer's `aikey-config-tool render` step substitutes real values
  # into the system-layer copy at `~/.aikey/config/aikey-proxy.yaml`.
  collector_url: "http://127.0.0.1:8090"
  collector_token: "<dev-placeholder>"
  service_token: "<dev-placeholder>"

  # collector_routes — per-RouteSource upload destinations. Populated by
  # `aikey-config-tool render` based on profile + login state.
  #   personal/oauth → local collector  (8090 on personal/trial)
  #   team           → EMPTY until `aikey account login --control-url <REMOTE>`
  #                    writes the remote team-server URL into the user layer.
  #                    🔴 NOT the local collector (bugfix 2026-08-20): this is a
  #                    PERSONAL install, it is not a team backend, and pointing
  #                    the team route here wrote an employee's TEAM usage into
  #                    their PERSONAL database. Empty = hold in the WAL.
  collector_routes:
    personal: "http://127.0.0.1:8090"
    team:     ""
    oauth:    "http://127.0.0.1:8090"

  queue_capacity: 10000
  upload_batch_size: 5
  upload_interval: 5s

  # WAL directory for usage event durability and dead letter storage.
  # Always set this — dead_letter.jsonl is written here for terminal upload failures.
  wal_dir: "~/.aikey/data/usage-wal"

log:
  level: "info"   # debug, info, warn, error
