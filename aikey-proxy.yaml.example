# aikey-proxy configuration
# Copy this file to aikey-proxy.yaml and modify as needed.

listen:
  host: "127.0.0.1"
  port: 27200

vault:
  path: "~/.aikey/data/vault.db"

# Virtual keys: map each virtual key token to a provider + vault entry.
# Clients use virtual keys instead of real provider keys.
virtual_keys:
  - id: "vk_dev_openai"
    token: "aikey_vk_openai_dev_001"
    provider: "openai"
    base_url: "https://api.openai.com/v1"
    key_alias: "openai:default"
    allowed_models:
      - "gpt-4o-mini"
      - "gpt-4.1-mini"
      - "gpt-4.1"

  - id: "vk_dev_anthropic"
    token: "aikey_vk_anthropic_dev_001"
    provider: "anthropic"
    base_url: "https://api.anthropic.com"
    key_alias: "anthropic:default"
    allowed_models:
      - "claude-sonnet-4-5-20250929"
      - "claude-haiku-4-5-20251001"

  - id: "vk_dev_kimi"
    token: "aikey_vk_kimi_dev_001"
    provider: "kimi"
    base_url: "https://api.moonshot.cn/v1"
    key_alias: "kimi:default"
    allowed_models:
      - "moonshot-v1-8k"
      - "moonshot-v1-32k"
      - "moonshot-v1-128k"

# Provider protocol configuration.
providers:
  openai:
    protocol: "openai"
    timeout: 120s
  anthropic:
    protocol: "anthropic"
    timeout: 120s
  kimi:
    protocol: "kimi"
    timeout: 120s

# Events (usage tracking) configuration.
events:
  db_path: "~/.aikey/data/events.db"
  batch_size: 100
  flush_interval: 5s

  # Usage reporting to collector-service (optional).
  # When collector_url is set, team-managed key usage events are uploaded
  # to the data service for org-level analytics.
  #
  # Leave collector_url empty or commented out for standalone-local mode
  # (personal BYOK only, no server). Enable it when a Control Service is
  # available and you want org-level usage tracking.
  #
  # Environment-specific defaults:
  #   Local dev / local server:   http://127.0.0.1:27300
  #   Private deployment:         http://<server-ip>:27300
  #   SaaS (future):              https://collector.aikey.dev
  #
  # collector_url: ""
  # collector_token: ""
  # queue_capacity: 10000
  # upload_batch_size: 100
  # upload_interval: 5s

  # WAL directory for usage event durability and dead letter storage.
  # Always set this — dead_letter.jsonl is written here for terminal upload failures.
  # If omitted, falls back to the events db_path directory (~/.aikey/data/).
  wal_dir: "~/.aikey/data/usage-wal"

log:
  level: "info"   # debug, info, warn, error
